{
  "name": "minios-classic",
  "version": "1.1.0",
  "private": true,
  "description": "A lightweight Windows 95 and Mac OS 9 inspired new-tab desktop.",
  "scripts": {
    "build": "npm run typecheck && esbuild src/main.ts --bundle --format=iife --target=chrome110 --outfile=web95.js",
    "build:watch": "esbuild src/main.ts --bundle --format=iife --target=chrome110 --outfile=web95.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "esbuild": "latest",
    "typescript": "latest"
  }
}
