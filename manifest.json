{
  "manifest_version": 3,
  "name": "MiniOS 95",
  "version": "1.0.0",
  "description": "A Windows 95 style desktop as your new tab page: folders of links, draggable windows, and a PowerShell / Bash / Zsh terminal.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_permissions": [
    "bookmarks"
  ],
  "key": ""
}
