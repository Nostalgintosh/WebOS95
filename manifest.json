{
  "manifest_version": 3,
  "name": "MiniOS Classic",
  "version": "1.1.0",
  "description": "A lightweight Windows 95 and Mac OS 9 inspired desktop for your new tab page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/win-icon/16.png",
    "32": "icons/win-icon/32.png",
    "48": "icons/win-icon/48.png",
    "128": "icons/win-icon/128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "key": ""
}
